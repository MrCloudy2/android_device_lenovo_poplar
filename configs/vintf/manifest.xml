    Input:
        device/mediatek/vendor/common/project_manifest/manifest_isphal.xml
        device/mediatek/vendor/common/project_manifest/manifest_cameraprovider.xml
        device/mediatek/vendor/common/project_manifest/manifest_postproc.xml
